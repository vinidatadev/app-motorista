# ============================================================
# Exemplo de backend/.env para o Azure (Container Apps + Blob S3 + Postgres Flexible)
# O script scripts/azure-setup.sh gera esses valores automaticamente.
# Copie para backend/.env apenas se for testar fora do Azure.
# ============================================================

# PostgreSQL Flexible Server (SSL obrigatorio — o backend detecta ?sslmode= e ativa SSL)
DATABASE_URL=postgresql+asyncpg://motorista:TroqueEstaSenha123!@app-motorista-pg.postgres.database.azure.com:5432/appdb?sslmode=require

# Azure AD (opcional — aceita tokens Microsoft)
AZURE_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# JWT local — gere: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_EXPIRE_H=8

# CORS — dominio real do frontend (ex.: https://app-motorista-frontend.<hash>.eastus2.azurecontainerapps.io)
ALLOWED_ORIGINS=http://localhost:5173,https://SEU-FRONTEND.azurecontainerapps.io

# Geocoding direto (endereco -> lat/lng) — OpenCage: https://opencagedata.com/dashboard
OPENCAGE_KEY=

# --- Storage: Azure Blob Storage com S3-compatible API (substitui o MinIO) ---
# Endpoint S3 do blob storage (sem https — o backend completa; aceita https se informado)
MINIO_ENDPOINT=SUA_CONTA.blob.core.windows.net
# Chaves da Storage Account (Settings > Access keys)
MINIO_ACCESS_KEY=SUA_CONTA
MINIO_SECRET_KEY=SUA_CHAVE_DE_ACESSO
# URL publica do blob (base das presigned URLs das fotos)
MINIO_PUBLIC_URL=https://SUA_CONTA.blob.core.windows.net
# Container (bucket) de fotos — criado automaticamente pelo backend
MINIO_CLIENTES_BUCKET=clientes

# Producao: vazio (crie o admin via ALLOW_SETUP temporario)
SEED_DEMO=
ALLOW_SETUP=